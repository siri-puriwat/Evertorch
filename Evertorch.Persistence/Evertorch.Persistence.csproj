<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <!-- Explicit so the provider's older transitive Relational cannot win version resolution. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <!-- Migrations tooling for dotnet-ef only; nothing from it ships with the server. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Evertorch.Game\Evertorch.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Evertorch.Persistence.Tests" />
  </ItemGroup>

</Project>

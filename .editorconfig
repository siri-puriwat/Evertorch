root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,xml,props,targets,asmdef}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4

# C# 9-compatible structure across Unity and .NET projects.
csharp_style_namespace_declarations = block_scoped:error
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_style_require_accessibility_modifiers = always:suggestion

# Repository-wide readability conventions.
csharp_prefer_braces = true:error
csharp_new_line_before_open_brace = all
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:error
csharp_preserve_single_line_blocks = false
csharp_preserve_single_line_statements = false

# Rider/ReSharper keeps namespace contents flush with the namespace declaration.
resharper_csharp_indent_inside_namespace = false

# Interfaces use I + PascalCase.
dotnet_naming_rule.interfaces_begin_with_i.severity = error
dotnet_naming_rule.interfaces_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_begin_with_i.style = interface_style
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.interface_style.required_prefix = I
dotnet_naming_style.interface_style.capitalization = pascal_case

# Private and protected fields use m_camelCase.
dotnet_naming_rule.non_public_fields_use_m_prefix.severity = error
dotnet_naming_rule.non_public_fields_use_m_prefix.symbols = non_public_fields
dotnet_naming_rule.non_public_fields_use_m_prefix.style = m_camel_case
dotnet_naming_symbols.non_public_fields.applicable_kinds = field
dotnet_naming_symbols.non_public_fields.applicable_accessibilities = private, protected, protected_internal, private_protected
dotnet_naming_style.m_camel_case.required_prefix = m_
dotnet_naming_style.m_camel_case.capitalization = camel_case

# Constants and static readonly fields use PascalCase without m_.
dotnet_naming_rule.constants_use_pascal_case.severity = error
dotnet_naming_rule.constants_use_pascal_case.symbols = constants
dotnet_naming_rule.constants_use_pascal_case.style = pascal_case
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.static_readonly_fields_use_pascal_case.severity = error
dotnet_naming_rule.static_readonly_fields_use_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_use_pascal_case.style = pascal_case
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

# Async methods communicate their contract in the name.
dotnet_naming_rule.async_methods_end_in_async.severity = warning
dotnet_naming_rule.async_methods_end_in_async.symbols = async_methods
dotnet_naming_rule.async_methods_end_in_async.style = async_style
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.async_style.capitalization = pascal_case
dotnet_naming_style.async_style.required_suffix = Async

dotnet_naming_style.pascal_case.capitalization = pascal_case

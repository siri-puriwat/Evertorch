* text=auto eol=lf

# C# and structured project files.
*.cs text diff=csharp eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.meta text eol=lf

# Windows batch files misparse labels and blocks with LF line endings.
*.cmd text eol=crlf

# Unity YAML uses text serialization and Unity Smart Merge when configured.
*.unity text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.asset text merge=unityyamlmerge eol=lf
*.mat text merge=unityyamlmerge eol=lf
*.anim text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.mixer text merge=unityyamlmerge eol=lf
*.mask text merge=unityyamlmerge eol=lf


# Delivered art (Content Pipeline §6): models and textures in Git LFS, and a delivery's manifest pair byte for byte,
# so its hashes still check.
Evertorch.Client/Assets/_Project/Art/**/*.fbx filter=lfs diff=lfs merge=lfs -text
Evertorch.Client/Assets/_Project/Art/**/*.png filter=lfs diff=lfs merge=lfs -text
Evertorch.Client/Assets/_Project/Art/Deliveries/*/manifest.json -text
Evertorch.Client/Assets/_Project/Art/Deliveries/*/manifest.sha256 -text

# Local-only internal discussions and private project notes.
/_Evertorch-Private/
/CLAUDE.local.md

# Rider, Visual Studio, and per-user settings.
.idea/
.vs/
*.DotSettings.user
*.suo
*.user
*.userprefs

# .NET build output.
**/[Bb]in/
**/[Oo]bj/
/artifacts/

# Local infrastructure secrets, and certificates with their keys.
/docker/.env
*.pfx
*.p12

# Unity-generated data for the nested client project.
/Evertorch.Client/.utmp/
/Evertorch.Client/[Ll]ibrary/
/Evertorch.Client/[Tt]emp/
/Evertorch.Client/[Ll]ogs/
/Evertorch.Client/[Uu]ser[Ss]ettings/
/Evertorch.Client/[Bb]uild/
/Evertorch.Client/[Bb]uilds/
/Evertorch.Client/[Mm]emoryCaptures/
/Evertorch.Client/[Rr]ecordings/
/Evertorch.Client/*.csproj
/Evertorch.Client/*.sln
/Evertorch.Client/*.slnx
/Evertorch.Client/Assets/Plugins/Editor/JetBrains*

# Client content package copied in by `Evertorch.Tools content build --client-out`.
/Evertorch.Client/Assets/StreamingAssets/
/Evertorch.Client/Assets/StreamingAssets.meta

# Written by every Addressables content build to keep its runtime types from being stripped.
/Evertorch.Client/Assets/AddressableAssetsData/link.xml
/Evertorch.Client/Assets/AddressableAssetsData/link.xml.meta

